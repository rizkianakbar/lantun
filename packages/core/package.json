{
  "name": "@lantun/core",
  "version": "0.1.0",
  "description": "Read any article aloud with word highlighting, plus reading aids for low vision, dyslexia and ADHD. One script, no backend.",
  "keywords": [
    "text-to-speech",
    "tts",
    "read-aloud",
    "accessibility",
    "a11y",
    "dyslexia",
    "reading",
    "widget",
    "speech-synthesis"
  ],
  "license": "MIT",
  "author": "rizkianakbar",
  "homepage": "https://github.com/rizkianakbar/lantun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizkianakbar/lantun.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/rizkianakbar/lantun/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
