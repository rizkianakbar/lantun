{
  "name": "@lantun/voice-kitten",
  "version": "0.1.0",
  "description": "Lifelike, on-device English voices for Lantun, powered by Kitten TTS. Nothing downloads until a reader picks one.",
  "keywords": [
    "text-to-speech",
    "tts",
    "kitten-tts",
    "onnx",
    "lantun",
    "voices"
  ],
  "license": "MIT",
  "author": "rizkianakbar",
  "homepage": "https://github.com/rizkianakbar/lantun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizkianakbar/lantun.git",
    "directory": "packages/voice-kitten"
  },
  "bugs": "https://github.com/rizkianakbar/lantun/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@lantun/core": "workspace:^"
  },
  "devDependencies": {
    "@lantun/core": "workspace:^",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
