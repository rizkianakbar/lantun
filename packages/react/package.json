{
  "name": "@lantun/react",
  "version": "0.1.0",
  "description": "React component for Lantun: read articles aloud with highlighting and reading aids.",
  "keywords": [
    "react",
    "text-to-speech",
    "read-aloud",
    "accessibility",
    "lantun"
  ],
  "license": "MIT",
  "author": "rizkianakbar",
  "homepage": "https://github.com/rizkianakbar/lantun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizkianakbar/lantun.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/rizkianakbar/lantun/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lantun/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
